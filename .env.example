# ============================================================
# RiskShield AI — Environment Configuration
# ============================================================
# Copy to .env and fill in ALL values before deploying.
# Generate secrets: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#
# SECURITY: Never commit .env to git. Never use defaults in production.
# ============================================================

# === DATABASE ===
# PostgreSQL for production (required)
DATABASE_URL=postgresql+asyncpg://riskshield:CHANGE_ME@postgres:5432/riskshield

# === SECURITY (ALL REQUIRED FOR PRODUCTION) ===
# Random 64-char string — used for JWT signing
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
RISKSHIELD_SECRET_KEY=CHANGE_ME

# Admin API key for privileged endpoints (merchants CRUD, monitoring)
# This is NOT a Razorpay key — it's your system's admin key
RISKSHIELD_API_KEY=CHANGE_ME

# === RAZORPAY (required for webhook verification) ===
# Get from: https://dashboard.razorpay.com/app/keys (Live mode)
RAZORPAY_KEY_ID=rzp_live_xxxxx
RAZORPAY_KEY_SECRET=xxxxx
# Get from: https://dashboard.razorpay.com/app/webhooks (your webhook secret)
RAZORPAY_WEBHOOK_SECRET=xxxxx

# === MODEL ===
MODEL_PATH=/app/ml_models/fraud_detector_v2.joblib

# === CORS (production domains only) ===
# Comma-separated list of allowed origins
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# === HARDENING ===
DEBUG=false
LOG_LEVEL=WARNING
RATE_LIMIT_PER_MINUTE=60

# === REDIS ===
REDIS_URL=redis://redis:6379/0
