# RiskShield AI — Environment Configuration
# Copy to .env and fill in values

# Database (PostgreSQL for production, SQLite for local dev)
DATABASE_URL=postgresql+asyncpg://riskshield:riskshield@localhost:5432/riskshield

# Security
RISKSHIELD_SECRET_KEY=change-me-to-a-random-secret
RISKSHIELD_API_KEY=riskshield-test-key-2026

# Model
MODEL_PATH=../ml/models/fraud_detector_v2.joblib

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=INFO
DEBUG=false

# Redis
REDIS_URL=redis://redis:6379/0

# Kafka
KAFKA_BROKERS=kafka:9092

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120

# Razorpay Webhooks (for production)
RAZORPAY_WEBHOOK_SECRET=
